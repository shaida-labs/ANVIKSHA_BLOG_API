# Copy this file to .env and replace every placeholder before running the app.
# The real .env file is gitignored and must never be committed.

APP_NAME=ANVIKSHA API
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# PostgreSQL (psycopg 3) URL. Replace the password with your own.
DATABASE_URL=postgresql+psycopg://blog_user:replace_with_your_password@localhost:5432/blog_api_db
DATABASE_ECHO=false

# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cover image uploads. UPLOAD_DIR is relative to the project root unless absolute.
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_MAX_IMAGE_PIXELS=40000000
